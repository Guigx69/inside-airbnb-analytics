# =============================================================================
# Inside Airbnb Analytics - Local environment configuration
# Copy this file to .env and replace the example values.
# NEVER commit the real .env file.
# =============================================================================

SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
DBT_SNOWFLAKE_PASSWORD=your_password

# Shared Snowflake configuration
SNOWFLAKE_WAREHOUSE=DBT_WH
SNOWFLAKE_DATABASE=AIRBNB

# RAW ingestion
SNOWFLAKE_ROLE=INGESTION_ROLE
SNOWFLAKE_SCHEMA=RAW

# dbt
SNOWFLAKE_DBT_ROLE=DBT_ROLE
DBT_SNOWFLAKE_SCHEMA=DBT_YOUR_USERNAME